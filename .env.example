# Application
APP_NAME="Arpon Framework"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arpon
DB_USERNAME=root
DB_PASSWORD=

# SQLite (when using sqlite connection)
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_FOREIGN_KEYS=true

# MySQL SSL (optional)
# MYSQL_ATTR_SSL_CA=/path/to/ca-cert.pem

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=arpon_cache

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=arpon_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_CONNECTION=

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Mail Log Channel (when using log mailer)
MAIL_LOG_CHANNEL=

# Filesystem
FILESYSTEM_DISK=local
ASSET_URL=

# Hashing
BCRYPT_ROUNDS=10
