{
    "version": "1.0.0",
    "name": "arpon/framework",
    "description": "A high-performance, lightweight PHP MVC framework core designed for simplicity and speed.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "framework",
        "mvc",
        "arpon",
        "arpon-framework",
        "clean-code"
    ],
    "homepage": "https://github.com/arponascension1/arpon-framework",
    "authors": [
        {
            "name": "Arpon",
            "email": "arponascension20@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Arpon\\": "src/Arpon/"
        },
        "files": [
            "src/Arpon/Support/helpers.php",
            "src/Arpon/Database/Support/helpers.php",
            "src/Arpon/Session/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Arpon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    }
}
